import os
import sqlite3
from functools import wraps
from pathlib import Path

from flask import (
    Flask, render_template, request, redirect,
    url_for, session, flash, abort
)

BASE_DIR = Path(__file__).resolve().parent
DATABASE = BASE_DIR / "database.db"

app = Flask(__name__)
app.secret_key = os.environ.get("SECRET_KEY", "change-this-secret-key-before-deployment")


def get_db():
    conn = sqlite3.connect(DATABASE)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with get_db() as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS reservations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                full_name TEXT NOT NULL,
                phone TEXT NOT NULL,
                email TEXT,
                event_type TEXT NOT NULL,
                event_date TEXT NOT NULL,
                event_time TEXT NOT NULL,
                guests INTEGER NOT NULL,
                description TEXT,
                status TEXT NOT NULL DEFAULT 'در انتظار بررسی',
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)


def admin_required(view):
    @wraps(view)
    def wrapped(*args, **kwargs):
        if not session.get("admin_logged_in"):
            return redirect(url_for("admin_login"))
        return view(*args, **kwargs)
    return wrapped


@app.context_processor
def inject_globals():
    return {"site_name": "سالن آمفی‌تئاتر الزهرا"}


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/about")
def about():
    return render_template("about.html")


@app.route("/facilities")
def facilities():
    return render_template("facilities.html")


@app.route("/gallery")
def gallery():
    return render_template("gallery.html")


@app.route("/reservation", methods=["GET", "POST"])
def reservation():
    if request.method == "POST":
        full_name = request.form.get("full_name", "").strip()
        phone = request.form.get("phone", "").strip()
        email = request.form.get("email", "").strip()
        event_type = request.form.get("event_type", "").strip()
        event_date = request.form.get("event_date", "").strip()
        event_time = request.form.get("event_time", "").strip()
        description = request.form.get("description", "").strip()

        try:
            guests = int(request.form.get("guests", "0"))
        except ValueError:
            guests = 0

        if not all([full_name, phone, event_type, event_date, event_time]):
            flash("لطفاً همه فیلدهای ضروری را تکمیل کنید.", "error")
            return render_template("reservation.html")

        if guests < 1 or guests > 400:
            flash("تعداد شرکت‌کنندگان باید بین ۱ تا ۴۰۰ نفر باشد.", "error")
            return render_template("reservation.html")

        with get_db() as db:
            db.execute("""
                INSERT INTO reservations
                (full_name, phone, email, event_type, event_date,
                 event_time, guests, description)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                full_name, phone, email, event_type, event_date,
                event_time, guests, description
            ))

        flash("درخواست شما ثبت شد. برای هماهنگی نهایی با شما تماس گرفته می‌شود.", "success")
        return redirect(url_for("reservation"))

    return render_template("reservation.html")


@app.route("/admin/login", methods=["GET", "POST"])
def admin_login():
    if session.get("admin_logged_in"):
        return redirect(url_for("admin_dashboard"))

    if request.method == "POST":
        username = os.environ.get("ADMIN_USERNAME", "admin")
        password = os.environ.get("ADMIN_PASSWORD", "change-me-now")

        if (
            request.form.get("username", "") == username
            and request.form.get("password", "") == password
        ):
            session["admin_logged_in"] = True
            return redirect(url_for("admin_dashboard"))

        flash("نام کاربری یا رمز عبور اشتباه است.", "error")

    return render_template("admin_login.html")


@app.route("/admin")
@admin_required
def admin_dashboard():
    with get_db() as db:
        reservations = db.execute(
            "SELECT * FROM reservations ORDER BY id DESC"
        ).fetchall()
    return render_template("admin_dashboard.html", reservations=reservations)


@app.route("/admin/reservation/<int:reservation_id>/status", methods=["POST"])
@admin_required
def update_status(reservation_id):
    status = request.form.get("status", "")
    allowed = {"در انتظار بررسی", "تأیید شده", "رد شده"}

    if status not in allowed:
        abort(400)

    with get_db() as db:
        db.execute(
            "UPDATE reservations SET status = ? WHERE id = ?",
            (status, reservation_id)
        )

    flash("وضعیت درخواست به‌روزرسانی شد.", "success")
    return redirect(url_for("admin_dashboard"))


@app.route("/admin/logout", methods=["POST"])
@admin_required
def admin_logout():
    session.clear()
    return redirect(url_for("index"))


@app.errorhandler(404)
def not_found(error):
    return render_template("error.html", code=404, message="صفحه موردنظر پیدا نشد."), 404


@app.errorhandler(500)
def server_error(error):
    return render_template("error.html", code=500, message="خطایی در سرور رخ داده است."), 500


init_db()

if __name__ == "__main__":
    app.run(debug=True)
